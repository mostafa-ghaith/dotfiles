{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/dotfiles || exit 0; git pull --rebase --autostash -q 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Syncing dotfiles (pull)…",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/dotfiles || exit 0; git add -A; git diff --cached --quiet || git commit -q -m \"auto-sync $(date '+%F %T') [$(hostname -s)]\"; git pull --rebase --autostash -q 2>/dev/null; git push -q 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Syncing dotfiles (commit+push)…"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/dotfiles/claude-sync/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "posthog@claude-plugins-official": false,
    "firecrawl@claude-plugins-official": true,
    "supabase@claude-plugins-official": false,
    "microsoft-docs@claude-plugins-official": true,
    "devops-automation@claude-code-templates": true,
    "docx-template@eigenpal": true,
    "last30days@last30days-skill": true
  },
  "extraKnownMarketplaces": {
    "eigenpal": {
      "source": {
        "source": "github",
        "repo": "eigenpal/docx-template-skill"
      }
    },
    "claude-code-templates": {
      "source": {
        "source": "github",
        "repo": "davila7/claude-code-templates"
      }
    },
    "last30days-skill": {
      "source": {
        "source": "github",
        "repo": "mvanhorn/last30days-skill"
      }
    }
  },
  "effortLevel": "xhigh",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
